/*
 * Wallpaper picker with live thumbnail previews.
 * Inherits accent/background/foreground from the active visual-mode
 * colorscheme via shared/settings.rasi.
 */

@import "shared/settings.rasi"

configuration {
    show-icons:                     true;
    disable-history:                true;
}

window {
    transparency:                   "real";
    background-color:               @background;
    text-color:                     @foreground;
    border:                         0px;
    border-radius:                  0px;
    width:                          100%;
    height:                         100%;
}

prompt {
    enabled:                        true;
    padding:                        1.35% 0.75% 1% 0.75%;
    background-color:               @background-focus;
    text-color:                     @accent;
    border-radius:                  100%;
}

textbox-prompt-colon {
    padding:                        1% 0% 1% 0%;
    background-color:               @background-focus;
    text-color:                     @foreground;
    expand:                         false;
    str:                            " :: ";
}

entry {
    background-color:               @al;
    text-color:                     @foreground;
    placeholder-color:              @foreground;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search wallpapers...";
    padding:                        1.0% 0.5% 1% 0.5%;
    blink:                          true;
}

inputbar {
    children:                       [ prompt, entry ];
    background-color:               @background-focus;
    text-color:                     @foreground;
    expand:                         false;
    border:                         0% 0.2% 0.3% 0%;
    border-radius:                  100%;
    border-color:                   @accent;
}

listview {
    background-color:               @al;
    padding:                        0px;
    columns:                        6;
    lines:                          3;
    spacing:                        1.2%;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               @al;
    border:                         0%;
    border-radius:                  0%;
    border-color:                   @accent;
    children:                       [ inputbar, listview ];
    spacing:                        2%;
    padding:                        4% 4%;
}

element {
    background-color:               @background-focus;
    text-color:                     @foreground;
    orientation:                    vertical;
    border-radius:                  14px;
    border:                         0px;
    border-color:                   @accent;
    padding:                        4px;
    spacing:                        6px;
}

element-icon {
    background-color:               inherit;
    text-color:                     inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           240px;
    border:                         0px;
    border-radius:                  12px;
}

element-text {
    background-color:               @al;
    text-color:                     inherit;
    font:                           @text-font;
    expand:                         true;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    margin:                         0.5% 0% 0% 0%;
}

element selected {
    background-color:               @background-focus;
    text-color:                     @accent;
    border:                         0% 0% 0.6% 0.4%;
    border-radius:                  14px;
    border-color:                   @accent;
}
