/*
 * Shortcuts cheatsheet menu
 * Fullscreen overlay listing every Openbox keybinding, grouped by category.
 */

@import "shared/settings.rasi"

configuration {
    font:                           "Cantarell 11";
    show-icons:                     false;
    disable-history:                true;
}

window {
    transparency:                   "real";
    background-color:               @background;
    text-color:                     @foreground;
    border:                         0px;
    border-color:                   @accent;
    border-radius:                  0px;
    width:                          100%;
    height:                         100%;
}

prompt {
    enabled:                        true;
    padding:                        1.35% 0.75% 1% 0.75%;
    background-color:               @background-focus;
    text-color:                     @accent;
    border-radius:                  100%;
}

entry {
    background-color:               @al;
    text-color:                     @foreground;
    placeholder-color:              @foreground;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search shortcuts...";
    padding:                        1.0% 0.5% 1% 0.5%;
    blink:                          true;
}

inputbar {
    children:                       [ prompt, entry ];
    background-color:               @background-focus;
    text-color:                     @foreground;
    expand:                         false;
    border:                         0% 0.2% 0.3% 0%;
    border-radius:                  100%;
    border-color:                   @accent;
}

listview {
    background-color:               @al;
    padding:                        0px;
    columns:                        2;
    spacing:                        1%;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               @al;
    border:                         0% 0% 0% 0%;
    border-radius:                  0% 0% 0% 0%;
    border-color:                   @accent;
    children:                       [ inputbar, listview ];
    spacing:                        1.5%;
    padding:                        5% 8% 5% 8%;
}

element {
    background-color:               @background-focus;
    text-color:                     @foreground;
    orientation:                    horizontal;
    border-radius:                  100%;
    padding:                        0.75% 0.75% 0.75% 1%;
}

element-text {
    background-color:               @al;
    text-color:                     inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0% 0.5% 0% 0.5%;
}

element selected {
    background-color:               @background-focus;
    text-color:                     @accent;
    border:                         0% 0% 0.3% 0.2%;
    border-radius:                  100%;
    border-color:                   @accent;
}
